\graphicspath{{immagini/}{immagini/loghi/}{diagrammi/pdf/}}
\newcommand{\logo}[3]{%
  \IfFileExists{immagini/loghi/#1.pdf}{\includegraphics[height=#2]{#1.pdf}}{%
  \IfFileExists{immagini/loghi/#1.png}{\includegraphics[height=#2]{#1.png}}{}}}

\newcommand{\copertina}{%
  \begin{titlepage}
    \centering
