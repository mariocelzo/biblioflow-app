# Copiare questo file in .env. Non inserire mai segreti reali nel repository.

# PostgreSQL applicativo locale (Docker Compose)
POSTGRES_USER=biblioflow
POSTGRES_PASSWORD=CHANGEME_LOCAL_ONLY
POSTGRES_DB=biblioflow
DATABASE_URL=postgresql://biblioflow:CHANGEME_LOCAL_ONLY@localhost:5432/biblioflow?schema=public

# Override opzionale usato dagli script test:db:*.
# Deve identificare esplicitamente un database di test.
TEST_DATABASE_URL=postgresql://biblioflow_test@127.0.0.1:5433/biblioflow_test?schema=public

# Applicazione e autenticazione
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGEME_WITH_GENERATED_VALUE_MIN_32_CHARACTERS
NEXT_PUBLIC_APP_NAME=BiblioFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protezione delle automazioni e firma dei QR code.
# QR_SECRET e' opzionale: senza valore viene derivato da NEXTAUTH_SECRET.
CRON_SECRET=CHANGEME_WITH_GENERATED_VALUE_MIN_16_CHARACTERS
QR_SECRET=CHANGEME_WITH_GENERATED_VALUE

# Servizi e integrazioni opzionali
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
