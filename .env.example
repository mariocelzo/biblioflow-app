# Copiare questo file in .env. Non inserire mai segreti reali nel repository.

# PostgreSQL applicativo locale (Docker Compose)
POSTGRES_USER=biblioflow
POSTGRES_PASSWORD=CHANGEME_LOCAL_ONLY
POSTGRES_DB=biblioflow
DATABASE_URL=postgresql://biblioflow:CHANGEME_LOCAL_ONLY@localhost:5432/biblioflow?schema=public

# Override opzionale usato dagli script test:db:*.
# Deve identificare esplicitamente un database di test.
TEST_DATABASE_URL=postgresql://biblioflow_test@127.0.0.1:5433/biblioflow_test?schema=public

# Applicazione e autenticazione
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGEME_WITH_GENERATED_VALUE_MIN_32_CHARACTERS
NEXT_PUBLIC_APP_NAME=BiblioFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protezione delle automazioni e firma dei QR code.
# QR_SECRET e' opzionale: senza valore viene derivato da NEXTAUTH_SECRET.
CRON_SECRET=CHANGEME_WITH_GENERATED_VALUE_MIN_16_CHARACTERS
QR_SECRET=CHANGEME_WITH_GENERATED_VALUE

# Servizi e integrazioni opzionali
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Invio email (verifica dell'indirizzo) ---
# Serve a recapitare il link di conferma: senza uno di questi backend chi si
# registra NON puo' verificare l'email e quindi NON puo' accedere (il login
# blocca gli account non verificati, finding A-5).
# Basta configurare UNA delle due strade; se ci sono entrambe vince Resend.
#
# 1) Brevo — la strada scelta dal progetto, perche' NON richiede un dominio
#    proprio: basta verificare UN singolo indirizzo mittente dalla dashboard
#    (Senders & IP), e da li' si puo' scrivere a chiunque. Piano gratuito:
#    300 email al giorno. La chiave si crea in SMTP & API > API Keys.
BREVO_API_KEY=
#
# 2) Resend, in alternativa. ATTENZIONE: senza un dominio verificato consente
#    di scrivere SOLO all'indirizzo del titolare dell'account, quindi non basta
#    per gli utenti reali.
RESEND_API_KEY=
#
# Mittente dei messaggi: deve essere un indirizzo autorizzato presso il
# provider scelto, altrimenti l'invio viene rifiutato.
MAIL_FROM=BiblioFlow <indirizzo-verificato@example.com>
#
# NOTA: non usiamo SMTP. Passerebbe da `nodemailer`, ma next-auth beta ne
# ammette solo le versioni ^7/^8, che hanno tutte vulnerabilita' di gravita'
# alta: `npm audit --audit-level=high` fallirebbe in CI. Le API HTTP qui sopra
# non richiedono alcuna dipendenza.
#
# In SVILUPPO si puo' lasciare tutto vuoto: il mailer non spedisce nulla e
# stampa in console il link di verifica, sufficiente per completare il flusso.
