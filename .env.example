# Copiare questo file in .env. Non inserire mai segreti reali nel repository.

# PostgreSQL applicativo locale (Docker Compose)
POSTGRES_USER=biblioflow
POSTGRES_PASSWORD=CHANGEME_LOCAL_ONLY
POSTGRES_DB=biblioflow
DATABASE_URL=postgresql://biblioflow:CHANGEME_LOCAL_ONLY@localhost:5432/biblioflow?schema=public

# Override opzionale usato dagli script test:db:*.
# Deve identificare esplicitamente un database di test.
TEST_DATABASE_URL=postgresql://biblioflow_test@127.0.0.1:5433/biblioflow_test?schema=public

# Applicazione e autenticazione
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGEME_WITH_GENERATED_VALUE_MIN_32_CHARACTERS
NEXT_PUBLIC_APP_NAME=BiblioFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protezione delle automazioni e firma dei QR code.
# QR_SECRET e' opzionale: senza valore viene derivato da NEXTAUTH_SECRET.
CRON_SECRET=CHANGEME_WITH_GENERATED_VALUE_MIN_16_CHARACTERS
QR_SECRET=CHANGEME_WITH_GENERATED_VALUE

# Servizi e integrazioni opzionali
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Invio email (verifica dell'indirizzo) ---
# Serve a recapitare il link di conferma: senza uno di questi backend chi si
# registra NON puo' verificare l'email e quindi NON puo' accedere (il login
# blocca gli account non verificati, finding A-5).
# Basta configurare UNA delle due strade; se ci sono entrambe vince Resend.
#
# 1) SMTP — la strada scelta dal progetto, perche' NON richiede un dominio
#    proprio. Con Gmail servono la verifica in due passaggi attiva e una App
#    Password (16 caratteri) al posto della password normale:
#      SMTP_HOST=smtp.gmail.com
#      SMTP_PORT=587
#      SMTP_USER=indirizzo@gmail.com
#      SMTP_PASSWORD=<app password>
#    La porta 465 usa TLS implicito, la 587 STARTTLS. Funziona allo stesso modo
#    con l'SMTP di ateneo o con Brevo.
#    Per lo SVILUPPO in locale conviene un server di posta finto, che cattura i
#    messaggi senza spedirli davvero e li mostra su http://localhost:8025 :
#      docker run -d --name biblioflow-mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
#      SMTP_HOST=localhost / SMTP_PORT=1025 (utente e password qualsiasi)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
#
# 2) Resend: unica chiave, nessuna dipendenza aggiuntiva. ATTENZIONE: senza un
#    dominio verificato consente di scrivere SOLO all'indirizzo del titolare
#    dell'account, quindi non basta per gli utenti reali.
RESEND_API_KEY=
#
# Mittente dei messaggi. Se lasciato vuoto con SMTP viene usato SMTP_USER, che
# e' anche l'unico mittente che Gmail accetta.
MAIL_FROM=
