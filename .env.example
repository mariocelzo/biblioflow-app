# PostgreSQL locale (Docker Compose)
POSTGRES_USER=biblioflow
POSTGRES_PASSWORD=CHANGEME_LOCAL_ONLY
POSTGRES_DB=biblioflow
DATABASE_URL=postgresql://biblioflow:CHANGEME_LOCAL_ONLY@localhost:5432/biblioflow?schema=public

# Applicazione e autenticazione
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGEME_WITH_GENERATED_VALUE_MIN_32_CHARACTERS
NEXT_PUBLIC_APP_NAME=BiblioFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protezione delle automazioni e firma dei QR code
CRON_SECRET=CHANGEME_WITH_GENERATED_VALUE_MIN_16_CHARACTERS
QR_SECRET=CHANGEME_WITH_GENERATED_VALUE

# Servizi locali e integrazioni opzionali
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
